# Copy to .deploy.env (gitignored) and fill in. No secret lives here: the
# App Store Connect .p8 stays in ~/.appstoreconnect/private_keys/ and is read
# only by scripts/lib/asc.py, never echoed or passed on a command line.

# App Store Connect API key, 10 characters.
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API
ASC_KEY_ID=

# The team's issuer UUID, shown once at the top of that same page. One issuer
# id serves every key on the team.
ASC_ISSUER_ID=

# Password for the dedicated local signing keychain this repo creates.
# Any strong random string; it never leaves this machine.
#   openssl rand -base64 24
SIGNING_KEYCHAIN_PASSWORD=
